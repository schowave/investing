[Unit]
Description=investing: täglichen Abgleich in die Warteschlange stellen
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/investing
# Der Worker arbeitet ihn ab, nach einem eventuell laufenden Lauf von Hand (Seite „Abgleich“).
ExecStart=/usr/bin/docker compose exec -T worker node scripts/enqueue.ts sync
