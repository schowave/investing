{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Bash(creds)",
      "Bash(creds *)",
      "Bash(*$(creds*)",
      "Bash(*.env.local*)",
      "Bash(*/opt/investing/.env*)",
      "Bash(*investing.env*)",
      "Bash(*printenv*)",
      "Bash(* env)",
      "Bash(* env *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(*docker compose exec*env*)",
      "Bash(*docker inspect*)",
      "Bash(*pct exec*env*)",
      "Bash(*pct pull*)",
      "Bash(*lxc:exec*env*)"
    ]
  }
}
